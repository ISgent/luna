# ============================================================
# Luna — конфигурация окружения
# Скопируйте в .env и заполните. .env в git НЕ попадает.
# Все значения ниже — дефолты, можно не задавать явно.
# ============================================================

# --- Discord ---
DISCORD_TOKEN=
# ID основного пользователя (старый знакомый Luna). Без него все считаются новыми.
OWNER_ID=
# Ограничить работу одним сервером (необязательно)
GUILD_ID=

# Общий ключ DashScope — фолбэк для LLM/TTS/STT/EMBEDDING, если их ключи не заданы
DASHSCOPE_API_KEY=

# --- LLM (основной разговорный + фоновый) ---
# Любая OpenAI-совместимая точка: DashScope, OpenAI, OpenRouter, Groq...
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Основная модель: быстрая разговорная (латентность важнее "глубины")
LLM_MODEL=qwen-flash
# Фоновая модель: умнее, ТОЛЬКО для memory extraction / consolidation / summary
LLM_BACKGROUND_MODEL=qwen-plus
# Температура разговора: 0.8 — живо, но без «случайных мемов» на каждой реплике.
# Выше 0.85 Luna начинает переигрывать и сочинять, ниже 0.6 — отвечает однообразно.
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# --- Embeddings (retrieval памяти) ---
# Пустые значения наследуются от LLM_*
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=8000

# --- TTS ---
# dashscope = qwen3-tts-flash (WAV по подписанной ссылке), openai = /audio/speech (wav/pcm), mock = тишина для тестов
TTS_PROVIDER=dashscope
TTS_API_KEY=
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_MODEL=qwen3-tts-flash
# Голос можно менять без кода: Cherry, Serena, Ethan, Chelsie и др.
TTS_VOICE=Cherry
TTS_ENABLED=true
TTS_TIMEOUT_MS=15000

# --- STT ---
# dashscope = qwen3-asr-flash (чат с input_audio), openai = /audio/transcriptions, mock
STT_PROVIDER=dashscope
STT_API_KEY=
STT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_MODEL=qwen3-asr-flash
STT_LANGUAGE=ru
STT_TIMEOUT_MS=15000

# --- Голосовой режим ---
VOICE_ENABLED=true
# Пользователь заговорил — Luna замолкает
VOICE_BARGE_IN=true
# Сама заходит в голосовой канал владельца при старте (иначе — по команде /voice)
VOICE_AUTO_JOIN=false
# Пороги VAD (энергия кадра, мс тишины, мин/макс длина фразы)
VAD_START_RMS=220
VAD_END_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_MS=20000

# --- База данных ---
DATABASE_PATH=./data/luna.db

# --- Память ---
MEMORY_ENABLED=true
# Сколько последних сообщений держать в short-term (до summarization)
SHORT_TERM_SIZE=24
# hybrid = embeddings + keyword (FTS/LIKE); keyword = без вызова embeddings (быстрее всего); semantic = только вектора
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.1
# Веса ранжирования retrieval
MEMORY_W_SEMANTIC=1.0
MEMORY_W_RECENCY=0.5
MEMORY_W_IMPORTANCE=0.6
MEMORY_W_EMOTION=0.35
MEMORY_W_RECALL=0.25
MEMORY_W_PERSON_BOOST=1.25
MEMORY_RECENCY_HALFLIFE_DAYS=14
# Порог похожести для dedupe (0..1)
DEDUPE_SIMILARITY=0.9
# Консолидация: слияние мелких памятей по расписанию
CONSOLIDATION_ENABLED=true
CONSOLIDATION_INTERVAL_HOURS=12
CONSOLIDATION_MIN_CLUSTER=6
CONSOLIDATION_PROTECT_IMPORTANCE=0.7
# После скольких сообщений в канале делать summary
SUMMARY_TRIGGER_MESSAGES=60

# --- Эмоции ---
# Период полураспада отклонений настроения к базовой линии, минут
EMOTION_DECAY_HALFLIFE_MIN=90

# --- Конвейер ответов ---
# Батчинг "очереди быстрых сообщений" (0 = отвечать сразу)
DEBOUNCE_MS=600
# Если новое сообщение пришло до первого токена и с начала генерации прошло < N мс — перегенерировать с учётом нового
REGENERATE_WINDOW_MS=1500
# Как часто можно редактировать сообщение со стримом (rate limit Discord: 5 edit/5s)
MESSAGE_EDIT_INTERVAL_MS=900
MESSAGE_CHUNK_LIMIT=1800

# --- Логирование / телеметрия ---
LOG_LEVEL=info
LOG_PRETTY=true
TELEMETRY_ENABLED=true

# --- Прочее ---
# Preseed отношений с владельцем ("давно знакомы")
SEED_OWNER_RELATIONSHIP=true
