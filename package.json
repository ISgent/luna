{
  "name": "luna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Luna — живой Discord-персонаж с долгосрочной памятью, эмоциями и отношениями",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run copy-assets",
    "copy-assets": "node -e \"require('fs').cpSync('src/storage/migrations','dist/storage/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "pino": "^9.5.0",
    "prism-media": "^1.3.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
